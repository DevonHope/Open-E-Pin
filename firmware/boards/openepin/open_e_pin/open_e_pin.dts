/*
 * Open E-Pin board v0.1: Raytac MDBT50Q-1MV2 (nRF52840), GDEH0169E02 round
 * e-paper on SPI, side button, LiPo with divider and charger status line.
 * Pin map: hardware/README.md and hardware/scripts/design.py.
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/regulator/nrf5x.h>
#include "open_e_pin-pinctrl.dtsi"

/ {
	model = "Open E-Pin";
	compatible = "openepin,open-e-pin";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
	};

	aliases {
		sw0 = &button0;
	};

	buttons {
		compatible = "gpio-keys";
		/* SW1 side button to GND on P1.06, internal pull-up. */
		button0: button_0 {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Side button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	zephyr,user {
		/* VBAT_SYS through a 10M/10M divider on P0.29 (AIN5). */
		io-channels = <&adc 5>;
		/* BQ25101 ~CHG through 100k on P0.31: low while charging. */
		chg-gpios = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&reg1 {
	/* The module carries the DC/DC inductors. */
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&uicr {
	/* P0.18 is the reset pin, on the RESET test pad. */
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		/* 10M source impedance: longest acquisition time, 100 nF hold cap. */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&epd_spi_default>;
	pinctrl-1 = <&epd_spi_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

	epd: epd@0 {
		compatible = "gooddisplay,gdeh0169e02";
		reg = <0>;
		spi-max-frequency = <2000000>;	/* as the vendor sample */
		dc-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;	/* high = data */
		reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
		/* BUSY low = busy: spec pin table and the vendor sample agree (note 6-4 says the opposite). */
		busy-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;	/* TPS22916C enable */
		width = <400>;
		height = <400>;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		code_partition: partition@0 {
			label = "code";
			reg = <0x00000000 0x000f8000>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 0x00008000>;
		};
	};
};

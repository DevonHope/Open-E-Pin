CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y

# No 32.768 kHz crystal on board v0.1: run the low-frequency clock from the
# internal RC oscillator. If the module turns out to carry the crystal, switch
# to CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL to save a little power.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

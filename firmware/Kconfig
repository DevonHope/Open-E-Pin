mainmenu "Open E-Pin firmware"

menu "Open E-Pin"

config EPIN_ADV_TIMEOUT_S
	int "Advertising window after a button press, in seconds"
	default 60

config EPIN_IDLE_TIMEOUT_S
	int "Time to stay awake after the app disconnects, in seconds"
	default 30
	help
	  The pin keeps advertising for this long after a disconnect so an
	  interrupted upload can resume, then goes to System OFF.

config EPIN_BATTERY_POLL_S
	int "Battery measurement interval while awake, in seconds"
	default 60

config EPIN_MIN_REFRESH_MV
	int "Lowest battery voltage that still allows a panel refresh, in mV"
	default 3400
	help
	  A refresh draws a burst of current from a 60 mAh cell. Below this
	  voltage the pin refuses COMMIT and CLEAR with LOW_BATTERY.

config EPIN_EPD_BUSY_TIMEOUT_S
	int "Longest wait for a panel refresh, in seconds"
	default 120
	help
	  The vendor sample allows 120 s for the refresh, 60 s for power
	  on/off and 15 s for reset.

config EPIN_EPD_CS_PER_BYTE
	bool "Toggle panel chip select around every byte"
	help
	  The vendor sample raises CS after every byte. By default the frame
	  goes out in 4 kB bursts with CS held low, which is much faster.
	  Turn this on if the panel shows garbage.

config EPIN_HW_REV
	int "Hardware revision reported in the Info characteristic"
	default 1

endmenu

source "Kconfig.zephyr"
